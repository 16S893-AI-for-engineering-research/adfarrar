---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const navItems = [
  { href: `${base}/`, label: "Home" },
  { href: `${base}/about/`, label: "About Me" },
  { href: `${base}/project/`, label: "Project" },
  { href: `${base}/cv/`, label: "CV" },
  { href: `${base}/devlog/`, label: "Dev Log" },
];

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-nav">
  <div class="wrap">
    <a class="brand-mark frizzle-cursor" href={`${base}/`}>
      <span class="dot"></span>
      allegra&nbsp;farrar
    </a>
    <nav class="nav-links" aria-label="Primary">
      {navItems.map((item) => {
        const href = item.href.replace(/\/$/, "") || "/";
        return (
          <a
            class="frizzle-cursor"
            href={item.href}
            aria-current={href === current ? "page" : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
