---
// Hero animation: a satellite performing an "adaptive sensing" sweep
// over a rotating, developing hurricane (spiral cloud bands).
---

<canvas class="hero-canvas" data-hero></canvas>

<style>
  .hero-canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  function initHero(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = Math.min(window.devicePixelRatio || 1, 2);
    let frame = 0;

    function resize() {
      const parent = canvas.parentElement;
      width = parent ? parent.clientWidth : window.innerWidth;
      height = parent ? parent.clientHeight : window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function drawHurricane(cx: number, cy: number, radius: number, rotation: number) {
      const bandCount = 5;
      for (let i = 0; i < bandCount; i++) {
        const bandRotation = rotation + (i * Math.PI * 2) / bandCount;
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(bandRotation);

        ctx.beginPath();
        const turns = 2.4;
        const steps = 90;
        for (let s = 0; s <= steps; s++) {
          const t = s / steps;
          const angle = t * Math.PI * 2 * turns;
          const r = radius * 0.08 + radius * 0.92 * t;
          const x = Math.cos(angle) * r;
          const y = Math.sin(angle) * r * 0.62; // flatten slightly for a disc feel
          if (s === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = `rgba(200, 220, 255, ${0.16 - i * 0.015})`;
        ctx.lineWidth = 10 - i * 1.3;
        ctx.lineCap = "round";
        ctx.stroke();
        ctx.restore();
      }

      // eye of the storm
      const eyeGradient = ctx.createRadialGradient(cx, cy, 0, cx, cy, radius * 0.12);
      eyeGradient.addColorStop(0, "rgba(10, 14, 24, 0.9)");
      eyeGradient.addColorStop(1, "rgba(10, 14, 24, 0)");
      ctx.beginPath();
      ctx.arc(cx, cy, radius * 0.12, 0, Math.PI * 2);
      ctx.fillStyle = eyeGradient;
      ctx.fill();
    }

    function drawSatellite(x: number, y: number, angle: number) {
      ctx.save();
      ctx.translate(x, y);
      ctx.rotate(angle);

      // body
      ctx.fillStyle = "#dfe7f5";
      ctx.fillRect(-6, -4, 12, 8);

      // solar panels
      ctx.fillStyle = "#4fd1ff";
      ctx.fillRect(-22, -2, 14, 4);
      ctx.fillRect(8, -2, 14, 4);

      // antenna dish
      ctx.beginPath();
      ctx.arc(0, -8, 4, Math.PI, Math.PI * 2);
      ctx.strokeStyle = "#9aa3b8";
      ctx.lineWidth = 1.2;
      ctx.stroke();

      ctx.restore();
    }

    function drawSweepBeam(satX: number, satY: number, targetX: number, targetY: number, alpha: number) {
      const gradient = ctx.createLinearGradient(satX, satY, targetX, targetY);
      gradient.addColorStop(0, `rgba(79, 209, 255, ${alpha})`);
      gradient.addColorStop(1, "rgba(79, 209, 255, 0)");

      const dx = targetX - satX;
      const dy = targetY - satY;
      const len = Math.hypot(dx, dy);
      const nx = -dy / len;
      const ny = dx / len;
      const spread = 10;

      ctx.beginPath();
      ctx.moveTo(satX, satY);
      ctx.lineTo(targetX + nx * spread, targetY + ny * spread);
      ctx.lineTo(targetX - nx * spread, targetY - ny * spread);
      ctx.closePath();
      ctx.fillStyle = gradient;
      ctx.fill();
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);

      const cx = width * 0.55;
      const cy = height * 0.55;
      const radius = Math.min(width, height) * 0.32;
      const rotation = frame * 0.004;

      drawHurricane(cx, cy, radius, rotation);

      // satellite orbit path
      const orbitRadiusX = Math.min(width, height) * 0.55;
      const orbitRadiusY = Math.min(width, height) * 0.28;
      const orbitAngle = frame * 0.006;
      const satX = cx + Math.cos(orbitAngle) * orbitRadiusX * -1 + width * 0.05;
      const satY = cy - orbitRadiusY - height * 0.08 + Math.sin(orbitAngle) * 20;

      // sweeping beam target oscillates across the storm
      const sweepT = (Math.sin(frame * 0.02) + 1) / 2;
      const targetX = cx - radius * 0.5 + sweepT * radius;
      const targetY = cy + Math.sin(sweepT * Math.PI) * radius * 0.2;

      drawSweepBeam(satX, satY, targetX, targetY, 0.22);
      drawSatellite(satX, satY, orbitAngle + Math.PI / 2);

      frame += 1;
      requestAnimationFrame(draw);
    }

    resize();
    window.addEventListener("resize", resize);
    draw();
  }

  document.querySelectorAll<HTMLCanvasElement>("canvas[data-hero]").forEach(initHero);
</script>
