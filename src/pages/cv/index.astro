---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pdf = `${base}/files/AFarrar_CV.pdf`;
---

<BaseLayout
  title="CV — Allegra Farrar"
  description="Curriculum vitae: education, research projects, publications, grants, awards, and teaching."
>
  <section class="cv-hero">
    <div class="wrap">
      <div class="cv-head">
        <div>
          <span class="eyebrow">curriculum vitae</span>
          <h1>Allegra Farrar</h1>
          <p class="lead mt-16">
            Reimagining space technology to address the uncertainties of Earth's
            climate — developing real-time computational and mission design
            strategies for Earth-observing satellites to improve the study of
            tropical cyclones and transient, unpredictable climate trends.
          </p>
          <p class="small mt-16">Cambridge, MA 02139 &middot; adfarrar@mit.edu</p>
        </div>
        <div class="cv-actions">
          <a class="btn primary frizzle-cursor" href={pdf} download>
            Download PDF &darr;
          </a>
          <a class="btn frizzle-cursor" href={pdf} target="_blank" rel="noopener">
            Open in new tab &nearr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------- inline PDF viewer -->
  <section class="reveal cv-embed-section">
    <div class="wrap">
      <div class="cv-embed">
        <object data={pdf} type="application/pdf" aria-label="Allegra Farrar CV">
          <div class="cv-fallback">
            <p>
              Your browser will not display the PDF inline.
              <a class="frizzle-cursor" href={pdf} download>Download it instead &darr;</a>
            </p>
          </div>
        </object>
      </div>
      <p class="small mt-16">
        Scroll inside the frame, or download the PDF above. A text summary follows
        for anything that does not render.
      </p>
    </div>
  </section>

  <!-- ------------------------------------------------- text summary -->
  <section class="reveal">
    <div class="wrap">
      <span class="eyebrow">education</span>
      <h2>Education</h2>
      <div class="grid cols-3 mt-24">
        <article class="card">
          <span class="cv-when">Expected May 2027</span>
          <h3>Ph.D. Candidate, Aeronautics &amp; Astronautics</h3>
          <p>
            Massachusetts Institute of Technology &middot; Space Enabled Research
            Group &middot; Advisor: Danielle Wood
          </p>
        </article>
        <article class="card">
          <span class="cv-when">May 2022</span>
          <h3>S.M., Aeronautics &amp; Astronautics</h3>
          <p>
            MIT &middot; Astrodynamics, Space Robotics &amp; Controls Laboratory
            &middot; Advisor: Richard Linares
          </p>
        </article>
        <article class="card">
          <span class="cv-when">May 2020</span>
          <h3>B.S., Mechanical Engineering</h3>
          <p>
            The George Washington University, Washington DC &middot;
            <em>Summa cum laude</em>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      <span class="eyebrow">research</span>
      <h2>Research projects</h2>
      <div class="cv-list mt-24">
        <article class="cv-item">
          <div class="cv-item-when">2025–present</div>
          <div>
            <h3>Adaptive Sensing for Earth Science Satellites</h3>
            <p class="cv-org">NASA Jet Propulsion Laboratory — SURP grant project</p>
            <p>
              Bayesian inference-driven adaptive sampling that optimises observing
              strategy from learned relationships as data is collected, prioritising
              regional uncertainty over pre-programmed selection of known phenomena.
              In coordination with CARICOOS to quantify the link between satellite
              measurements and real-time decision capability.
            </p>
          </div>
        </article>

        <article class="cv-item">
          <div class="cv-item-when">2024–present</div>
          <div>
            <h3>Remote Sensing Data Assessment for TC Prediction in the Caribbean</h3>
            <p class="cv-org">Space Enabled Research Group — Research Assistant</p>
            <p>
              Leading investigation into missed sensing opportunities in CYGNSS data
              by adaptively modifying onboard quality-flag criteria, recovering
              observations currently discarded under strict flagging. Designing
              real-time scientific use of onboard-processed Level 1 data within
              power, storage, and compute constraints.
            </p>
          </div>
        </article>

        <article class="cv-item">
          <div class="cv-item-when">2023–2024</div>
          <div>
            <h3>Adaptive Sampling for Uncertain Environments</h3>
            <p class="cv-org">Model-based Embedded Robotic Systems Group</p>
            <p>
              Adaptive sampling algorithms for autonomous underwater vehicles, fusing
              domain knowledge with probabilistic programming models to navigate
              observation strategy under uncertain ocean terrain.
            </p>
          </div>
        </article>

        <article class="cv-item">
          <div class="cv-item-when">2020–2022</div>
          <div>
            <h3>Iterative LQR Method for Planetary Entry Uncertainty</h3>
            <p class="cv-org">Astrodynamics, Robotics &amp; Controls Lab — Master's thesis</p>
            <p>
              Closed-loop trajectory optimiser incorporating nonlinear atmospheric
              models and navigation uncertainty, demonstrating a reliable, robust,
              computationally reasonable method with certifiable guarantees for a
              safe crewed Mars landing.
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      <span class="eyebrow">publications &amp; presentations</span>
      <h2>Selected publications</h2>
      <ul class="cv-pubs mt-24">
        <li>
          <strong>Farrar, A.</strong>, Ruf, C., Balasubramaniam, R., Posselt, D.,
          Kruczkiewicz, A., Wood, D. (2025). Towards Adaptive Sensing: Identifying
          High-Utility Observations from GNSS-R Satellites using Bayesian Inference.
          <em>AGU 2025</em>. (Poster)
        </li>
        <li>
          <strong>Farrar, A.</strong>, Wood, D. (2025). An Onboard Analysis Model for
          Adaptive Remote Sensing of Tropical Cyclones. <em>76th IAC, Sydney</em>.
          (Paper &amp; presentation)
        </li>
        <li>
          <strong>Farrar, A.</strong>, Williams, B. (2024). Closing the Gap: Applying
          a Causal Model to Address Data Sparsity of Tropical Cyclones in the Global
          South. <em>AGU 2024</em>. (Poster)
        </li>
        <li>
          <strong>Farrar, A.</strong>, Williams, B. (2024). Discovering Causal Models
          of Cyclogenesis through an Informed Structural Learning Approach.
          <em>75th IAC, Milan</em>. (Paper &amp; poster)
        </li>
        <li>
          <strong>Farrar, A.</strong>, Doerr, B., Linares, R. (2022). An Iterative LQR
          Method for Addressing Model Uncertainty for Planetary Entry.
          <em>73rd IAC, Paris</em>. (Paper &amp; presentation)
        </li>
        <li>
          <strong>Farrar, A.</strong> (2022). An Iterative LQR Method for Addressing
          Model Uncertainty in the Mars Entry Problem. <em>S.M. thesis, MIT
          AeroAstro</em>.
        </li>
      </ul>
      <p class="small mt-16">Full list, including lectures and proposals, in the PDF.</p>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      <div class="grid cols-2">
        <div>
          <span class="eyebrow">grants</span>
          <h2>Grants</h2>
          <article class="card mt-16">
            <span class="cv-when">2025–2026 &middot; $60,000 &middot; Awarded</span>
            <h3>An Adaptive Sensing Framework for Improved Observing and Understanding of Tropical Cyclones</h3>
            <p>
              NASA JPL Strategic University Research Partnership. Derek Posselt (JPL
              PI), Danielle Wood (Co-I), Allegra Farrar (Co-I / student lead).
            </p>
          </article>
        </div>
        <div>
          <span class="eyebrow">awards</span>
          <h2>Awards &amp; fellowships</h2>
          <ul class="cv-awards mt-16">
            <li>NSF Graduate Research Fellow (2020)</li>
            <li>MIT Presidential Fellow (2020)</li>
            <li>GEM Fellow (2020)</li>
            <li>Matthew Isakowitz Fellow (2022)</li>
            <li>AeroAstro Outstanding Leadership Award (2023)</li>
            <li>Sigma Xi (2024)</li>
            <li>Christine Darden Scholar (2019)</li>
            <li>USRA Distinguished Undergraduate Award (2020)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      <span class="eyebrow">teaching &amp; leadership</span>
      <h2>Teaching &amp; leadership</h2>
      <div class="grid cols-2 mt-24">
        <article class="card">
          <span class="cv-when">January 2026</span>
          <h3>Global Classroom (Angola) — Teaching Assistant</h3>
          <p>
            Taught ~50 students from ISPTEC in Luanda on satellite technology for
            local sustainability solutions; mentored a subgroup mapping aquifers for
            clean water supply in drought-affected southern regions.
          </p>
        </article>
        <article class="card">
          <span class="cv-when">Spring 2025</span>
          <h3>Attitude Determination &amp; Control — Teaching Assistant</h3>
          <p>
            Wrote homework and exams and taught weekly recitation on rigid-body
            dynamics, Euler and Kepler equations, and state estimation.
          </p>
        </article>
        <article class="card">
          <span class="cv-when">2022–present</span>
          <h3>Patti Grace Smith — Near Peer Mentor</h3>
          <p>
            Supporting fellows entering the aerospace field, and continuing that
            support past graduation into the next phase of their careers.
          </p>
        </article>
        <article class="card">
          <span class="cv-when">Spring 2022</span>
          <h3>Certificate in Aerospace Innovation, MIT AeroAstro</h3>
          <p>
            Inaugural cohort; designed a start-up addressing orbital debris in
            low-Earth orbit — third place in the pitch competition.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cv-hero { padding-top: clamp(28px, 4.5vh, 56px); }

  .cv-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 26px;
    align-items: end;
  }

  .cv-actions { display: flex; flex-direction: column; gap: 10px; }

  @media (max-width: 780px) {
    .cv-head { grid-template-columns: 1fr; align-items: start; }
    .cv-actions { flex-direction: row; flex-wrap: wrap; }
  }

  .cv-embed-section { padding-top: clamp(20px, 3vh, 34px); }

  .cv-embed {
    border: 1px solid var(--card-bd);
    border-radius: 16px;
    overflow: hidden;
    background: #0a1120;
    height: min(78vh, 900px);
  }

  .cv-embed object { width: 100%; height: 100%; }

  .cv-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 30px;
    text-align: center;
  }

  .cv-when {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--blue);
    margin-bottom: 8px;
  }

  .cv-list { display: flex; flex-direction: column; gap: 4px; }

  .cv-item {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 22px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }

  .cv-item:last-child { border-bottom: 1px solid var(--line); }

  .cv-item-when {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    padding-top: 3px;
  }

  .cv-org {
    color: var(--pale);
    font-size: 13.5px;
    margin-bottom: 8px;
  }

  @media (max-width: 720px) {
    .cv-item { grid-template-columns: 1fr; gap: 8px; }
  }

  .cv-pubs { display: flex; flex-direction: column; gap: 14px; }

  .cv-pubs li {
    padding-left: 18px;
    position: relative;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.55;
    max-width: 80ch;
  }

  .cv-pubs li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    opacity: 0.65;
  }

  .cv-awards { display: flex; flex-direction: column; gap: 9px; }

  .cv-awards li {
    padding-left: 18px;
    position: relative;
    color: var(--muted);
    font-size: 14.5px;
  }

  .cv-awards li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cyan);
    opacity: 0.7;
  }
</style>
