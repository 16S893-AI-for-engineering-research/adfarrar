---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobeHero from "../components/GlobeHero.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="Allegra Farrar — Adaptive Sensing for Satellite Monitoring of Tropical Cyclones"
  description="PhD candidate at MIT AeroAstro and the Media Lab, designing adaptive sensing for Earth-observing satellites that watch tropical cyclones and environmental hazards."
>
  <!-- ============================= HERO ============================= -->
  <section class="hero">
    <div class="wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1>Earth-to-Orbit</h1>
          <p class="subtitle mt-8">
            Addressing the Information Gap for Effective Extreme Weather Planning
          </p>
          <p class="lead mt-16">
            Welcome! I'm Allegra, a phd candidate in my final year of study at
            MIT AeroAstro. My work centers on developing inferencing algorithms to
            assist satellites and other observation tools to catch and distribute
            critical information to the regional entities in need of it the most. For
            this project, we'll be using AI to design and optimize how these
            algorithms are architecting. Take a look through the website and learn
            more!
          </p>
          <span class="eyebrow">MIT AeroAstro &amp; Media Lab &middot; Space Enabled</span>
          <div class="flex gap-16 mt-24" style="flex-wrap: wrap;">
            <a class="btn primary frizzle-cursor" href={`${base}/project/`}>
              See the project outline &rarr;
            </a>
            <a class="btn frizzle-cursor" href={`${base}/about/`}>Who I am</a>
          </div>
        </div>

        <div class="hero-figure">
          <GlobeHero />
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= ROUTES ============================ -->
  <section class="reveal">
    <div class="wrap">
      <div class="entry-grid">
        <article class="entry-card">
          <span class="entry-kicker">01 &middot; About</span>
          <h3>Who am I?</h3>
          <a class="entry-link frizzle-cursor" href={`${base}/about/`}>
            More about me <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
        <article class="entry-card">
          <span class="entry-kicker">02 &middot; Project</span>
          <h3>What's my research?</h3>
          <a class="entry-link frizzle-cursor" href={`${base}/project/`}>
            Read the outline <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
        <article class="entry-card">
          <span class="entry-kicker">03 &middot; Dev log</span>
          <h3>How AI is Being Used?</h3>
          <a class="entry-link frizzle-cursor" href={`${base}/devlog/`}>
            Read the log <span aria-hidden="true">&rarr;</span>
          </a>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding-top: clamp(28px, 4.5vh, 56px); }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
  }

  .hero-copy h1 {
    max-width: 22ch;
    background: linear-gradient(100deg, #50b495 0%, #52cadb 45%, #fb3f45 100%);
    background-size: 200% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: title-sheen 9s ease-in-out 1s infinite alternate;
  }

  @keyframes title-sheen {
    from { background-position: 0% 50%; }
    to   { background-position: 100% 50%; }
  }

  .hero-copy .subtitle {
    font-size: clamp(15px, 1.8vw, 20px);
    color: #ffffff;
    max-width: 40ch;
    font-weight: 700;
  }

  .hero-figure { position: relative; }

  @media (max-width: 940px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-figure { order: -1; }
    .hero-copy h1 { max-width: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy h1 { animation: none; background-position: 0% 50%; }
  }

  /* home page route cards, borrowed shape from a bordered 3-up grid */
  .entry-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--card-bd);
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(172, 214, 225, 0.05), rgba(4, 7, 15, 0.2));
  }

  .entry-card {
    display: flex;
    flex-direction: column;
    padding: 24px 24px 22px;
    border-right: 1px solid var(--card-bd);
    transition: background 0.2s ease;
    position: relative;
  }

  .entry-card:last-child { border-right: none; }
  .entry-card:hover { background: rgba(80, 180, 149, 0.06); }

  .entry-kicker {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 10px;
  }

  .entry-card h3 { flex: 1 1 auto; margin-bottom: 18px; }

  .entry-link {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--blue);
    margin-top: auto;
    width: fit-content;
  }

  .entry-link::after { content: ""; position: absolute; inset: 0; }
  .entry-link:hover { color: var(--ink); }

  @media (max-width: 800px) {
    .entry-grid { grid-template-columns: 1fr; }
    .entry-card { border-right: none; border-bottom: 1px solid var(--card-bd); }
    .entry-card:last-child { border-bottom: none; }
  }
</style>
