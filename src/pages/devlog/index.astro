---
import BaseLayout from "../../layouts/BaseLayout.astro";

/**
 * Dev log — two-level structure.
 *
 * weeks[]  — outer accordions, one per week (newest first).
 *   .days[] — inner accordions, one per session day within the week.
 *     .body[] — paragraphs with optional badge.
 */

interface LogParagraph {
  badge?: string;
  text: string;
  figureLink?: string;
  figureLinkLabel?: string;
  paperLink?: string;
}

interface DayEntry {
  date: string;
  title: string;
  open: boolean;
  body: LogParagraph[];
}

interface WeekGroup {
  week: string;          // e.g. "Week 4"
  dateRange: string;     // e.g. "27 – 30 September 2026"
  open: boolean;
  days: DayEntry[];
}

const weeks: WeekGroup[] = [
  // ── WEEK 8 ──────────────────────────────────────────────────────────────
  {
    week: "Week 8",
    dateRange: "October – 1 November 2026",
    open: true,
    days: [
      {
        date: "1 November 2026",
        title: "Retrospective",
        open: true,
        body: [
          {
            badge: "delegated",
            text: "Put together a short summary of the project for my instructor, then had the agent go back over the whole session and sort everything into what I accepted and delegated, what I had to verify and how, and what I turned down or left open. The agent did almost all of the literature search, the document drafting, and the code reading.",
          },
          {
            badge: "checked",
            text: "I did almost all of the deciding, the pushing back, and the domain checking. Where I supplied a paper or an example from my own work, things moved fast. Where I let the agent run on its own reasoning about the science, it tended to produce something plausible and confident that I then had to unpick. The sort was more useful than I expected because it made the shape of the collaboration visible.",
          },
          {
            badge: "rejected",
            text: "The project started as an agent searching for better graph structures with a second agent converting the output into infrastructure risk. It ended as adding time and physical delays to a fixed literature graph and measuring whether naming the dominant driver survives the sampling rate I actually have. That is a much smaller and much more honest project, and I don't think I would have gotten there without handing off the literature search or being willing to argue with the answers.",
          },
        ],
      },
      {
        date: "October 2026 (day not recorded)",
        title: "New portfolio ideas and first CYGNSS demo figures",
        open: false,
        body: [
          {
            text: "Started playing around with some different ideas for the portfolio website now that I have more experience with the agents, which models are good for which tasks, and what prompts work well for them.",
          },
          {
            badge: "delegated",
            text: "Got the first round of figures back for the CYGNSS demo tool I intend to make part of my portfolio.",
          },
          {
            badge: "rejected",
            text: "The agent confused a lot of aspects of the image with jargon from random parts of our discussion and wasn't following the formats in the paper. I then had to work with the agent to … (this entry is unfinished in my notes).",
          },
        ],
      },
    ],
  },

  // ── WEEK 7 ──────────────────────────────────────────────────────────────
  {
    week: "Week 7",
    dateRange: "20 – 22 October 2026",
    open: false,
    days: [
      {
        date: "22 October 2026",
        title: "Finishing the curation plan and the final project scope",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Finished the curation plan for the class project. After going through the different options the agent came up with and talking with Prashanth, I decided to focus on the graph formulation piece. The agent interfaces by searching for papers on variable interactions relevant to the nodes I pick. Several experiments then test what those papers claim against 1. benchmark datasets and 2. causal graph laws (acyclicity, spurious links, etc.). I asked the agent to draft an .svg of this setup for the pod clinic, and the draft it came up with was helpful.",
            figureLink: "https://16s893-ai-for-engineering-research.github.io/adfarrar/images/causal-graph-architecture.svg",
            figureLinkLabel: "View architecture figure",
          },
          {
            badge: "rejected",
            text: "Dropped the part of the proposal that explored the renewable energy angle. The project started as an agent searching for better graph structures, a second agent converting the output into infrastructure risk estimates with fragility curves, and a Pareto front plus risk assessment tool as the deliverable. It ended as a series of experiments that add time and per-arrow physical delays to a literature-verified graph, then measure whether naming the dominant driver survives the sampling rate I actually have, with the satellite-only case as the central test.",
          },
          {
            text: "What survived from the original design: the evaluation graph harness as the main code deliverable, the sparse-data region motivation, and choosing test cases in Puerto Rico / the Caribbean.",
          },
          {
            badge: "rejected",
            text: "Still open: what is the architecture of each box in the diagram? Is it a function, a subagent, or just book-keeping? If agents are used, how do I keep the context window from growing too large (relaunch a new subagent every time?). Are there new skills I should develop? I plan to iterate on the design next week to nail down a setup and start implementing.",
          },
        ],
      },
      {
        date: "20 October 2026",
        title: "Delay discrepancy in the DDM figure",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "While reproducing the figure, the agent pointed out a discrepancy in the delay calculations and tested an empirical formula to correct it.",
          },
          {
            badge: "checked",
            text: "I brought the discrepancy and the agent's analysis to my colleague Scott, who verified the formula as well.",
          },
          {
            badge: "rejected",
            text: "Open: we are both stumped as to why the formula works. Scott supported accepting it until he can talk with the science team about what is driving the need for the correction, so I accepted the agent's suggestion for now, provisionally.",
          },
        ],
      },
      {
        date: "20 October 2026",
        title: "Handoff documentation",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Spent the week consolidating. Had the agent write a handoff file so another session could pick the project up without me re-explaining six weeks of decisions. I specifically asked it to record what had been considered and cut, with reasons, so I don't re-litigate the same options. I also asked it to keep my own corrections in there as data, including the three cases where it was confidently wrong, since that's a real finding for a class about working with agents.",
          },
          {
            badge: "checked",
            text: "I asked where the three failure signatures it had been labelling as results actually came from. They had been derived in the session rather than taken from any paper, and the agent had been referencing them by label before I had even seen the file that defined them.",
          },
          {
            badge: "rejected",
            text: "The failure signatures are now written down as needing empirical validation. If only one of them shows up when I run the experiment, the other two were speculation, and I say so. Still open on my end: the variable list with a specific paper behind each arrow, the numerical backend choice, and writing down the target accuracy before I run anything.",
          },
        ],
      },
    ],
  },

  // ── WEEK 6 ──────────────────────────────────────────────────────────────
  {
    week: "Week 6",
    dateRange: "October 2026",
    open: false,
    days: [
      {
        date: "14 October 2026",
        title: "Model formulation and catching confident mistakes",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "The most productive week, and also the week I had to check the agent the hardest. I brought in the AcyGP paper from Ayton, Camilli and Williams because it was close to what I'd been doing, and asked the agent to break it down against my own background in planning under uncertainty and Markov models. That one paper collapsed about four rounds of architecture speculation into a single concrete formulation with the property I wanted: observing one variable updates the uncertainty on all the others. By the end of the week the agent had written three files: methodology notes on the model, project manuscript notes with the evaluation procedures, and an upgrade document for my existing repository covering what I built, what it gets wrong, what assumptions are baked in, and what needs to change.",
          },
          {
            text: "Accepted: the build ladder it proposed (no time, then time in the input, then per-arrow physical delays), the recommendation to use a Matern kernel instead of the usual squared exponential since the atmosphere isn't infinitely smooth, and the recommendation to start from Gee and Ravela's published intensity equation rather than writing my own dynamics.",
          },
          {
            badge: "checked",
            text: "Three times the agent told me something confidently and was wrong. (1) It said information only flows along the arrows, which would have meant only children of observed variables were usable and would have gutted inferring sea surface temperature from observed roughness. I pushed back from first principles: conditioning a joint Gaussian is symmetric. (2) It said six hours was a hard floor on the weather emulator step. Pangu released one, three, six and twenty-four hour models. (3) When I asked where a set of stochastic differential equations came from, they turned out to have been invented and presented without saying so.",
          },
          {
            badge: "checked",
            text: "None of those were knowledge gaps. They were the agent being agreeable and filling in confidently rather than saying it didn't know. The project got better every time I refused an answer, and none of those errors would have surfaced on their own. I also flagged twice that the explanations were drifting into jargon and asked it to drop acronyms entirely, which helped a lot.",
          },
          {
            badge: "rejected",
            text: "The agent pushed structure learning on me again after I had already said no, and I called that out.",
          },
        ],
      },
      {
        date: "October 2026 (day not recorded)",
        title: "CYGNSS handbook gaps and the figure-demo plan",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "The agent identified documentation describing variables that exist in the CYGNSS handbook but are no longer part of the latest Level 1 data I'm working with. It also pointed out a discrepancy in how the delay is determined for the Delay Doppler Map (DDM). I finished the planning session with the agent for the figure demo and we settled on a class of functions where you feed a module the [lat, lon] regional boundaries and the time period (the rest of this note is unfinished).",
          },
          {
            badge: "checked",
            text: "I reached out to a colleague and author of the paper I'm building from, Scott Gleason, who led the Level 1 processing that runs onboard the satellite. The paper the handbook cites didn't exist on any online platform. Scott confirmed it was not published documentation, shared it with me, and confirmed the agent's suspicion that those variables are outdated.",
          },
          {
            badge: "rejected",
            text: "Open: Scott and I have started a conversation about determining these values by calculating them from other provided variables.",
          },
        ],
      },
    ],
  },

  // ── WEEK 5 ──────────────────────────────────────────────────────────────
  {
    week: "Week 5",
    dateRange: "5 – 6 October 2026",
    open: false,
    days: [
      {
        date: "6 October 2026",
        title: "Delegated tasks",
        open: false,
        body: [
          {
            text: "No notes recorded for this day yet.",
          },
        ],
      },
      {
        date: "5 October 2026",
        title: "Literature review and rescoping the project",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Picked the grill-me session back up, this time running grill-with-docs so it would check my proposal against the code I already have. I delegated the entire literature search across causal inference, Earth system causal discovery, hurricane intensity prediction, sensor placement, and agentic structure search, and did not re-run any of those searches myself. I had the agent write the literature landscape up into a file with a novelty scoreboard so I could see which of my claims were actually unoccupied.",
          },
          {
            text: "Four findings I accepted immediately, which killed most of my original one-pager: all four of the \"graph edit types\" I proposed were already published ideas. A paper with Runge on it had already done causal feature selection for hurricane intensity and recovered the same drivers I was using as motivation. A 2026 paper already runs wind fields through fragility curves to transmission line risk, with leave-one-storm-out validation on 11 typhoons. And the field's current position is that agents should not supply graph edges or orientations at all, because they lose to decades-old statistical methods in head-to-head tests.",
          },
          {
            badge: "checked",
            text: "I had to explicitly tell the agent to stop relying on memory and go search. When I asked for citations the first time it gave me a mix of real papers and things it half-remembered, so I started requiring it to flag anything it hadn't verified. It did start tagging those, but only after I asked.",
          },
          {
            badge: "rejected",
            text: "Cut: the agent-driven structure search, the infrastructure risk subagent, the Hazus fragility curves, and all the US grid asset data. I also caught myself repeating the week-one mistake of giving too much context without a clear ask. Sessions went much better when I picked one question and made the agent answer it before moving on.",
          },
        ],
      },
      {
        date: "5 October 2026",
        title: "Expanding the figure reproduction and curation plan",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Decided to build an expanded version of the figure reproduction as a demo tool, in parallel with the class project, and to use the agent to learn the signal processing of the satellite I'm using as a case study (CYGNSS). I'm starting with a curation plan, working with the Claude Opus 5.5 model. The goals: 1. translate the Level 1 format into a more interpretable geophysical format using the paper's transformation equations (including Fig. 9, the DDM in geophysical coordinates), and 2. produce figures showing how the earliest measurements change with time before heavy cal/val and filtering, to see whether key information is being lost.",
          },
          {
            badge: "delegated",
            text: "The session ended with the agent writing a literature review markdown file in my thesis repository, which I keep updating with the sources it finds. It has 8 sections, a novelty scoreboard, the \"persisting gaps\" paragraph backing my thesis claim, and the node-complexity math note. I asked for LaTeX format for easy integration with Overleaf and accepted it as written. I'll edit it once I merge it with the rest of my writing.",
          },
          {
            badge: "checked",
            text: "Ran a grill-me session on my approach from the one-pager I submitted at the start of the class. The agent verified my suspicion that having an agent decide on its own which nodes and edges to add or delete is not a good approach, and added paper sources confirming it. It also gave me useful language for the work: \"a causal graph data assimilation stand-in for single-pass operational valuation under a shifting observation node\".",
          },
          {
            badge: "rejected",
            text: "The agent deciding nodes and edges on its own was turned down, with the literature as backing.",
          },
        ],
      },
    ],
  },

  // ── WEEK 4 ──────────────────────────────────────────────────────────────
  {
    week: "Week 4",
    dateRange: "27 September – 1 October 2026",
    open: false,
    days: [
      {
        date: "1 October 2026",
        title: "Accepted, delegated, and checked: reviewing the proposal",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Literature search across causal inference, Earth-system causal discovery, hurricane intensity, sensor placement, and agentic structure search. I didn't re-run these searches myself.",
          },
          {
            badge: "delegated",
            text: "The finding that my original proposal's four \"edit types\" were all existing published ideas. I accepted this and dropped the structure-search framing.",
          },
          {
            badge: "delegated",
            text: "The finding that an existing paper (Ganesh et al., with Runge) already did causal feature selection for hurricane intensity with the same driver story I was motivating with. Accepted; repositioned.",
          },
          {
            badge: "delegated",
            text: "The finding that a 2026 paper already does storm wind → fragility curve → grid risk with stronger validation. Accepted; cut that half of the project.",
          },
          {
            badge: "checked",
            text: "Did the AI actually justify itself in each option? I asked directly why AI mattered in the option I liked most, and the agent had skipped the question.",
          },
          {
            badge: "rejected",
            text: "Pushing on it got the real answer: AI mostly didn't matter there, and the agent had changed the subject rather than saying so. That option got cut.",
          },
        ],
      },
      {
        date: "30 September 2026",
        title: "Reproducing Figure 9 with the physics",
        open: true,
        body: [
          {
            badge: "delegated",
            text: `While learning a lot developing the subagent workflow for reproducing the figure, it was taking longer than anticipated so I wanted to try a quicker approach. Because this was a complex task that required a lot of reasoning, I set the model to Opus and the thinking effort to xhigh. I gave it a single prompt: "Look at @IEEE_GNSSR_Tutorial_06985926.pdf and recreate Figure 9" and the agent was able to reference the physics equations and effectively reproduce the figure.`,
          },
          {
            badge: "checked",
            text: "Rather than tracing the bitmap, the agent regenerated the DDM from the paper's own bistatic radar equation (Eq. 11), the geometric-optics Kirchhoff approximation for σ₀ (Eq. 12), and the L-band-filtered mean-square slopes at U₁₀ = 5 m/s. It also digitised the published figure by inverting the colourbar in native CMYK space, then ran a verification comparing peak power, peak cell location, and full-grid correlation. Peak matched to within 3% (−169.3 dBW simulated vs −169.2 dBW published), correct cell location (0.00 kHz, +0.38 chips), and a full-grid correlation of 0.975.",
          },
          {
            text: "I didn't explicitly say to use the physics equations — the agent chose that over bitmap tracing on its own, which I thought was interesting. I'll still continue finishing the test and function subagents from the Sept 29 session, as implementing that workflow will be useful for the overall research project.",
            figureLink: "/adfarrar/images/figure9_comparison.png",
            figureLinkLabel: "View reproduced figure",
            paperLink: "/adfarrar/files/IEEE_GRSM_GNSSR_Tutorial_06985926.pdf",
          },
        ],
      },
      {
        date: "29 September 2026",
        title: "First test, subagent workflow",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Started developing the first test based on the first assignment. Imported the subagents extension and explored how to set up subagents and assign them to independent tasks after the conversation with Prashanth after class. Set one agent to develop and run tests and another to develop and run the function.",
          },
          {
            text: "Also learned that it's helpful to rely on heavier agents like Opus for planning sessions, then once a plan is in place, break it down into smaller, specific, and executable tasks to feed a cheaper agent like Sonnet to implement. Got as far as deciding on all the necessary checks for the test model — implementation to follow.",
          },
        ],
      },
      {
        date: "27 September 2026",
        title: "Skills, model thinking, and website iteration",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Started playing around with model thinking capacity, setting it to high or xhigh for heavy inferencing tasks. Used the grill-me skill to evaluate the project proposal with the model set to Opus and thinking effort to high.",
          },
          {
            badge: "checked",
            text: "Was impressed by how well the agent found relevant papers from reputable sites like arXiv that actually existed. With standard Sonnet from previous experiences, it would either hallucinate papers and make up DOI links, or give only marginally relevant results. With Opus at high thinking, it compared papers to the proposal and pointed out places where claims were unclear or were expressing novelty in areas that already had significant contributions.",
          },
          {
            text: "Also continued iterating on the website and exploring different stylistic changes. Noticed that rendering stylistic changes in a local HTML file to preview them before pushing is a cheaper choice. Also went back and forth between Sonnet and Opus to reduce cost — looking forward to learning more targeted ways of switching between models.",
          },
        ],
      },
    ],
  },

  // ── WEEK 3 ──────────────────────────────────────────────────────────────
  {
    week: "Week 3",
    dateRange: "24 September 2026",
    open: false,
    days: [
      {
        date: "24 September 2026",
        title: "Writing skill and adding project proposal to website",
        open: false,
        body: [
          {
            badge: "delegated",
            text: `Started writing a grant/fellowship proposal writing skill capable of taking a draft in bullet-point or sentence structure — possibly a collection of fragmented ideas — and turning it into a stronger draft based on my writing style and structure. Started by giving the agent two example statements I've written, but explicitly instructed it to "not analyze the entire statement yet."`,
          },
          {
            text: `Then shared a paragraph from each statement and asked it to "analyze them both for their style and structure" while I did the same in parallel, then compared responses. The agent did a much deeper analysis than I did — going into sentence structure, paragraph structure, common word choices, and categories of words I lean heavily on. I focused more on the overall flow of ideas and the reasoning behind structural choices. It compared the two analyses and drafted a first set of rules for the skill. Next step: give it a prompt, ask it to write a paragraph while I do the same in real time, then compare results and refine the rules.`,
          },
        ],
      },
    ],
  },

  // ── WEEK 2 ──────────────────────────────────────────────────────────────
  {
    week: "Week 2",
    dateRange: "14 – 17 September 2026",
    open: false,
    days: [
      {
        date: "17 September 2026",
        title: "Redesign — new palette, orbital system, timeline, CV and dev log",
        open: false,
        body: [
          {
            badge: "delegated",
            text: `Full visual redesign after the first version came out looking generic. Pulled the colour scheme directly out of my JPL SURP deck rather than picking accents by hand — the agent unzipped the .pptx, read the theme XML, and found the "Ocean-darkmode" scheme (bright blue #00AFFF, cyan #52CADB, coral #FA5A67, sand #F9D095, deep navy #031154). Site now matches the deck I actually present from.`,
          },
          {
            badge: "delegated",
            text: "Replaced the home hero animation. Old one was a flat hurricane spiral I didn't like; new one is an abstract graticule Earth with three satellites in inclined orbits, where only some passes acquire a target — the target lights coral and the satellite opens a beam. That is the adaptive sensing idea in one loop instead of a caption.",
          },
          {
            badge: "delegated",
            text: "Built the interactive inner solar system for the About page: Sun, Mercury, Venus, Earth, Mars on tilted elliptical orbits, the Moon orbiting Earth, and Sun–Earth L2 marked on the anti-Sun line with a small hexagonal JWST. Earth, Mars, Moon and L2 are clickable and open modals rather than new pages. Canvas hit-testing, keyboard arrow navigation as a fallback.",
          },
          {
            badge: "checked",
            text: "The world map inside the Earth modal is real data, not a hand-drawn approximation. Pulled Natural Earth 110m land vectors (public domain), reprojected to plate carrée in Python, simplified with Ramer–Douglas–Peucker down to 28 KB of SVG path, and dropped islands below an area threshold. Plate carrée specifically so pin placement from lat/lon is plain arithmetic with no projection library at runtime. Rendered it to PNG and looked at it before wiring it in.",
          },
          {
            badge: "checked",
            text: "Verified the shooting stars were actually gone from the starfield, not just turned down — the old Starfield component was deleted outright rather than left in with a flag, since nothing uses it any more. Confirmed the rain-on-window canvas is also gone from the project page.",
          },
          {
            badge: "rejected",
            text: "Did not let the agent write my bio, motivation, or timeline detail. It has my real dates from the CV and the structure I asked for, but every content section is marked [Placeholder] where the wording is mine to write. Same for the JWST internship and the dance section — structure is up so I can see the layout, words come later.",
          },
          {
            text: "Verification path: full npm run build after each page; Playwright screenshots of every page at desktop and mobile widths; console-error check on all five routes; the Natural Earth path rendered to PNG and inspected before use. Not yet verified: no cross-browser pass beyond Chromium, and the inline PDF <object> viewer is untested in Firefox and Safari.",
          },
        ],
      },
      {
        date: "17 September 2026",
        title: "First scaffold — Astro site, three pages, Mrs. Frizzle cursor",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "Scaffolded the initial Astro project with Home, About and Project pages, a shared layout and nav, and a GitHub Actions workflow for Pages deployment. Also three canvas animations: twinkling starfield, rain-on-window, and a satellite sweeping a hurricane.",
          },
          {
            badge: "delegated",
            text: "Easter egg: the agent took my Mrs. Frizzle PNG, flood-filled the solid white background to transparent with Pillow, trimmed and resized it to 34×64, and wired it up as a CSS custom cursor on every link and button.",
          },
          {
            badge: "rejected",
            text: "Rejected most of this design on review. It looked like a generic dark portfolio template — not my style, the hurricane hero graphic did not read as anything, the shooting stars were disorienting, and the abstract Earth/Mars circles on the About page sat on top of the text. Kept the Astro setup, the Frizzle cursor, and the deployment workflow; everything visual got rebuilt.",
          },
          {
            text: "Verification path: build passed, Playwright screenshots of all three pages, no console errors, and the cursor PNG confirmed loading 200 on every route. The thing screenshots could not tell me was whether I liked it — that took actually opening it.",
          },
        ],
      },
      {
        date: "14 & 16 September 2026",
        title: "Website development and project scope",
        open: false,
        body: [
          {
            badge: "delegated",
            text: `Continued working on the website and honing in on the scope of the class project. Tried continuing to prompt the agent with website examples I liked but with explicit instruction on what to pay attention to and what to implement from each site. Also gave it descriptions like "I want the website theme to be reflective of the research" and "choose colors that complement each other and the theme of hurricanes and earth science."`,
          },
          {
            badge: "rejected",
            text: "It still struggled to meet expectations with this prompting and started leading the website astray. The approach of pointing at style examples without precise constraints kept producing results that drifted from what I wanted.",
          },
        ],
      },
    ],
  },

  // ── WEEK 1 ──────────────────────────────────────────────────────────────
  {
    week: "Week 1",
    dateRange: "10 September 2026",
    open: false,
    days: [
      {
        date: "10 September 2026",
        title: "Getting set up",
        open: false,
        body: [
          {
            badge: "delegated",
            text: "First week was focused on setup. Downloaded pi and configured the Parley extension. Set up the initial repository and project structure in GitHub titled adfarrar, linked it to the class repository. Once setup was complete, began working on the first assignment — the website. Used pi to play around with different models and asked the agent to create a portfolio website using Astro.",
          },
          {
            badge: "rejected",
            text: "The main struggle was giving the agent too much context without enough clear, targeted instructions. Pointed the agent to the class repository and other student examples already live on the class website — which I later regretted, as it locked onto other students' style choices and copied them. Also gave it a lot of supplemental material (a presentation slide deck, my CV, a grant and fellowship proposal) intending to give the agent a better sense of my work and style. This ended up being too much information and it copied from those materials instead of creating something original.",
          },
          {
            text: "Learned that I needed to give the agent explicit instructions on what to implement and especially what not to implement, and to clarify upfront whether we're doing development and implementation or just planning.",
          },
        ],
      },
    ],
  },
];

const badgeLabel: Record<string, string> = {
  delegated: "Delegated",
  checked: "Checked",
  rejected: "Rejected / open",
};
---

<BaseLayout
  title="Dev Log — Allegra Farrar"
  description="What I delegated to the agent, what I verified myself, and what I rejected — logged per session."
>
  <section class="log-hero">
    <div class="wrap">
      <span class="eyebrow">AI-use dev log</span>
      <h1>Dev log</h1>
      <p class="lead mt-16">
        What I handed to the agent, how I checked it, and what I did not accept.
        Updated per working session — newest first.
      </p>

      <ul class="legend mt-24">
        <li><span class="badge delegated">Delegated</span> work the agent produced</li>
        <li><span class="badge checked">Checked</span> how I verified it</li>
        <li><span class="badge rejected">Rejected / open</span> what I turned down or left unresolved</li>
      </ul>
    </div>
  </section>

  <section class="reveal">
    <div class="wrap">
      {weeks.map((wk) => (
        <article class="week-entry">
          <div
            class="week-toggle frizzle-cursor"
            tabindex="0"
            role="button"
            aria-expanded={wk.open ? "true" : "false"}
          >
            <span class="week-chevron" aria-hidden="true"></span>
            <div class="week-header-text">
              <span class="week-label">{wk.week}</span>
              <span class="week-range">{wk.dateRange}</span>
            </div>
          </div>

          <div class="week-body" hidden={!wk.open}>
            {wk.days.map((day) => (
              <article class="log-entry">
                <p class="log-date">{day.date}</p>
                <h2
                  class="log-toggle frizzle-cursor"
                  tabindex="0"
                  role="button"
                  aria-expanded={day.open ? "true" : "false"}
                >
                  <span class="log-chevron" aria-hidden="true"></span>
                  {day.title}
                </h2>
                <div class="log-body" hidden={!day.open}>
                  {day.body.map((p) => (
                    <>
                      <p>
                        {p.badge && (
                          <span class:list={["badge", p.badge]}>{badgeLabel[p.badge]}</span>
                        )}
                        {p.text}
                      </p>
                      {p.paperLink && (
                        <p class="entry-link">
                          <a href={p.paperLink} target="_blank" rel="noopener" class="inline-fig-link frizzle-cursor">
                            → View paper
                          </a>
                        </p>
                      )}
                      {p.figureLink && (
                        <p class="entry-link">
                          <a href={p.figureLink} target="_blank" rel="noopener" class="inline-fig-link frizzle-cursor">
                            → {p.figureLinkLabel}
                          </a>
                        </p>
                      )}
                    </>
                  ))}
                </div>
              </article>
            ))}
          </div>
        </article>
      ))}

      <p class="small mt-40">
        Built with <a class="frizzle-cursor" href="https://github.com/earendil-works/pi-coding-agent" target="_blank" rel="noopener">pi</a>
        on MIT Parley, and read before merging.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .log-hero { padding-top: clamp(28px, 4.5vh, 56px); padding-bottom: 0; }

  .legend {
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 13.5px;
    color: var(--muted);
  }

  .legend li { display: flex; align-items: center; gap: 10px; }

  .badge {
    display: inline-block;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 5px;
    margin-right: 8px;
    vertical-align: 1.5px;
    flex: none;
  }

  .badge.delegated {
    background: rgba(80, 180, 149, 0.13);
    color: var(--blue);
    border: 1px solid rgba(80, 180, 149, 0.35);
  }

  .badge.checked {
    background: rgba(124, 208, 188, 0.13);
    color: var(--mint);
    border: 1px solid rgba(124, 208, 188, 0.35);
  }

  .badge.rejected {
    background: rgba(250, 90, 103, 0.12);
    color: var(--coral);
    border: 1px solid rgba(250, 90, 103, 0.35);
  }

  /* ── Week-level accordion ────────────────────────────────────────────── */
  .week-entry {
    margin-bottom: 28px;
    border: 1px solid var(--card-bd);
    border-radius: 10px;
    overflow: hidden;
  }

  .week-toggle {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 22px;
    cursor: pointer;
    user-select: none;
    background: rgba(255, 255, 255, 0.03);
    transition: background 0.18s ease;
  }

  .week-toggle:hover { background: rgba(255, 255, 255, 0.06); }
  .week-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: -2px; }

  .week-chevron {
    flex: none;
    width: 9px;
    height: 9px;
    border-right: 2px solid var(--blue);
    border-bottom: 2px solid var(--blue);
    transform: rotate(45deg);
    transition: transform 0.22s ease;
    margin-top: 2px;
  }

  .week-toggle[aria-expanded="true"] .week-chevron { transform: rotate(-135deg); }

  .week-header-text {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }

  .week-label {
    font-size: clamp(16px, 2vw, 19px);
    font-weight: 600;
    color: var(--fg);
    letter-spacing: 0.01em;
  }

  .week-range {
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .week-body {
    padding: 6px 22px 18px 22px;
    border-top: 1px solid var(--card-bd);
  }

  /* ── Day-level accordion (inside week) ──────────────────────────────── */
  .log-entry {
    border-left: 2px solid var(--card-bd);
    padding-left: 22px;
    margin-top: 22px;
