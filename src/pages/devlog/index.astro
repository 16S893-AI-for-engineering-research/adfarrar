</style>

<script>
  // Week-level toggles
  document.querySelectorAll<HTMLElement>(".week-toggle").forEach((toggle) => {
    const body = toggle.nextElementSibling as HTMLElement | null;
    if (!body) return;

    function flip() {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
      body!.hidden = open;
    }

    toggle.addEventListener("click", flip);
    toggle.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        flip();
      }
    });
  });

  // Day-level toggles
  document.querySelectorAll<HTMLElement>(".log-toggle").forEach((toggle) => {
    const body = toggle.nextElementSibling as HTMLElement | null;
    if (!body) return;

    function flip() {
      const open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", open ? "false" : "true");
      body!.hidden = open;
    }

    toggle.addEventListener("click", flip);
    toggle.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        flip();
      }
    });
  });
</script>
